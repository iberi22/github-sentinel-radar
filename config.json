{
  "project_name": "GitHub Sentinel & Radar",
  "version": "1.0.0",
  "anti_bot": {
    "enabled": true,
    "review_mode": true,
    "max_account_age_days": 10,
    "min_following_for_suspicion": 400,
    "max_followers_for_suspicion": 40,
    "following_to_followers_ratio": 30.0,
    "upstream_blocklist_url": "https://raw.githubusercontent.com/iberi22/github-sentinel-radar/main/data/blocklist.json"
  },
  "radar": {
    "enabled": true,
    "hibernation_days": 7,
    "max_starred_to_analyze": 50,
    "max_releases_to_track": 15,
    "max_discoveries": 10,
    "discovery_min_stars": 20,
    "discovery_max_stars": 20000,
    "discovery_pushed_within_days": 365,
    "discovery_created_within_days": 1095,
    "discovery_topics": 3,
    "exclude_starred": true,
    "exclude_seen": true,
    "seen_history_cap": 500
  },
  "review": {
    "enabled": true,
    "trust_threshold": 60,
    "max_users_to_scan": 200
  },
  "i18n": {
    "default_locale": "en",
    "supported_locales": [
      "en",
      "zh",
      "hi",
      "es",
      "fr",
      "ar",
      "bn",
      "pt",
      "ru",
      "ur"
    ]
  }
}